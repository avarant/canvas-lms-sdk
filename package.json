{
  "name": "@avarant/canvas-lms-sdk",
  "version": "0.1.1",
  "description": "Unofficial TypeScript SDK for Canvas LMS API - compatible with Node.js and Cloudflare Workers",
  "author": "avarant",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/avarant/canvas-lms-sdk.git"
  },
  "homepage": "https://github.com/avarant/canvas-lms-sdk#readme",
  "bugs": {
    "url": "https://github.com/avarant/canvas-lms-sdk/issues"
  },
  "keywords": [
    "canvas",
    "canvas-lms",
    "lms",
    "api",
    "sdk",
    "typescript",
    "instructure",
    "education",
    "cloudflare-workers",
    "node"
  ],
  "main": "./generated_typescript_sdk/dist/index.js",
  "types": "./generated_typescript_sdk/dist/index.d.ts",
  "module": "./generated_typescript_sdk/dist/esm/index.js",
  "files": [
    "generated_typescript_sdk/dist",
    "generated_typescript_sdk/src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "cd generated_typescript_sdk && npm run build",
    "prepare": "echo 'Skipping prepare for CI'",
    "test": "echo \"No tests configured yet\"",
    "lint": "cd generated_typescript_sdk && tsc --noEmit",
    "clean": "rm -rf generated_typescript_sdk/dist",
    "version": "npm run changelog && git add CHANGELOG.md",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "release": "npm version patch && git push && git push --tags",
    "release:minor": "npm version minor && git push && git push --tags",
    "release:major": "npm version major && git push && git push --tags",
    "prerelease": "npm version prerelease --preid=beta && git push && git push --tags",
    "prepublishOnly": "npm run build",
    "postversion": "npm run push-tags",
    "push-tags": "git push && git push --tags",
    "docs": "typedoc --out docs/api generated_typescript_sdk/src/index.ts",
    "scrape": "./scripts/scrape-canvas-lms-api-docs.py",
    "generate:swagger": "./scripts/generate-swagger-docs.py",
    "generate:sdk": "npm run merge:specs && npm run codegen",
    "merge:specs": "cd docs/canvas-lms-api/swagger && npx openapi-merge-cli",
    "codegen": "openapi-generator generate -g typescript-fetch -i docs/canvas-lms-api/swagger/openapi_merged.yaml -o ./generated_typescript_sdk --additional-properties=npmName=canvas-lms-sdk,supportsES6=true,npmVersion=$(node -p \"require('./package.json').version\"),withInterfaces=true,platform=browser"
  },
  "dependencies": {
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "conventional-changelog-cli": "^4.1.0",
    "typedoc": "^0.25.0",
    "typescript": "^5.0.0",
    "@openapitools/openapi-generator-cli": "^2.13.0",
    "openapi-merge-cli": "^1.3.0"
  },
  "peerDependencies": {
    "node-fetch": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "node-fetch": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
